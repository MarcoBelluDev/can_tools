          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000000404eb">
          <SHORT-NAME>MFL_Tastencode_2</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Beschreibt die Funktion einer fest zugeordneten Taste/Walze auf dem MFL. Ist MFL_Tastencode_1 wegen Betätigung einer Taste/Walze bereits mit einem Wert ungleich 0x0 belegt, so ändert sich bei Betätigung einer weiteren Taste/Walze der Wert dieses Signals von 0x0 auf den jeweiligen Tastencode.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
