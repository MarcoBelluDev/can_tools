        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000013fd1ce">
          <SHORT-NAME>VDSO_StDKmtg_Auth</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">State of VDSO_DKmtg_Auth. Shows if necessary QTS activities were performed after exchange of HCP1</L-2>
          </DESC>
