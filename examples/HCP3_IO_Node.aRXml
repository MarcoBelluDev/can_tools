        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000003e992">
          <SHORT-NAME>MFL_Tastencode_1</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Beschreibt die Funktion einer fest zugeordneten Taste/Walze auf dem MFL. Bei Betätigung ändert sich der Wert von 0x0 auf den jeweiligen Tastencode.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
