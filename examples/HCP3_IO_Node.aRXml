            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000006ea53">
          <SHORT-NAME>DI_KL_58xs</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Suchbeleuchtung Schalter
EIN-AUS-Schaltalgorithmus der allgemeinen Schaltersuchbeleuchtung. 
Im Detail beschrieben im 'Funktionslastenheft Dimmung MQB'.</L-2>
          </DESC>
