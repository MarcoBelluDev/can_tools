CM_ SG_ 1637 TF_Phone_FieldStrength "Signal strength:(linear scaled range)
0  = 0%
15 = 100%";
CM_ SG_ 1637 TF_Phone_init "Phone initialization indication
0 = Telephone is initialized 
1 = Initialization in progress ";
CM_ SG_ 1637 TF_Phone_mute "Request to mute audio
0 = Audio active 
1 = Mute (TF_Mute_Msg_Code tells the reason) 
";
CM_ SG_ 1637 TF_Phone_on "Displays the current phone status
0 = Phone not active (MMI off)
1 = Phone active (MMI on)";
CM_ SG_ 1637 TF_Phone_PIN_ok "Result of entering the PIN. 
0 = PIN was not accepted by the SIM-card. 
1 = PIN was accepted by the SIM-card.";
CM_ SG_ 1637 TF_Phone_RegistrationState "Network registration status: 
set field to exact value from +CREG. In 
case +CREG returns ERROR (or until first 
OK response comes after init bit switches 
to 0), set it to 7. 
0 = no service, not searching 
1 = registered at home network 
2 = no s";
CM_ SG_ 1637 TF_Phone_ring "Incoming or waiting call 
0 = phone does not ring  
1 = phone rings ";
CM_ SG_ 1637 TF_Phone_SIM_ok "State of the SIM card reader
0 = Telephone can not recognize SIM-card or no SIM-card inserted. 
1 = Telephone has detected the SIM card.";
CM_ SG_ 1637 TF_Phone_Status "Anrufstatus
0: idle state / no call active
1: incoming call
2: 2nd incoming call / waiting call
3: active call / multiparty call
4: outgoing call";
